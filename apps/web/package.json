{
  "name": "@visamp/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check-types": "next typegen && tsc --noEmit",
    "test:uploads": "node --experimental-strip-types --test scripts/upload-rules.test.mjs",
    "test:assets": "node --experimental-strip-types --test scripts/asset-rules.test.mjs",
    "test:tags": "node --experimental-strip-types --test lib/hosted-audio/read-tags.test.mts",
    "test:rpc-errors": "node --experimental-strip-types --test lib/hosted-audio/rpc-errors.test.mts",
    "verify:assets": "node --env-file=.env.local scripts/verify-asset-access.mjs",
    "clean": "rm -rf .next",
    "test:mp3": "node --experimental-strip-types --test lib/hosted-audio/inspect-mp3.test.mts lib/hosted-audio/upload-queue.test.mts",
    "test:audio": "node --test scripts/audio-detect.test.mjs",
    "test:editor": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@base-ui/react": "^1.7.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@visamp/player": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "hls.js": "^1.7.0",
    "lucide-react": "^1.31.0",
    "music-metadata": "^11.15.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "sharp": "0.35.3",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@visamp/typescript-config": "workspace:*",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
