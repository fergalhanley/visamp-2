{
  "extends": "@visamp/typescript-config/nextjs.json",
  "compilerOptions": {
    // The asset modules under lib/assets are imported directly by the Node
    // test runner, which needs explicit specifiers.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
