[
  {
    "AllowedOrigins": [
      "https://visamp.io",
      "https://www.visamp.io",
      "http://localhost:3000"
    ],
    "AllowedMethods": ["GET", "HEAD"],
    "AllowedHeaders": ["Range", "Content-Type"],
