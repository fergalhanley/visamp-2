# Supabase — both values are safe in the browser. Access control is RLS, not
# key secrecy. Copy to .env.local and fill in from the project's API settings.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Used by local Supabase Auth (production config lives in the dashboard).
SUPABASE_AUTH_CAPTCHA_SECRET=
# Server-only. Used by hosted-audio APIs and local operational scripts.
SUPABASE_SERVICE_ROLE_KEY=
API_RATE_LIMIT_HMAC_KEY=

# VisAmp-hosted audio — all server-only. The R2 token needs object read/write
# for these two buckets; it does not need account-wide administrative access.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=media-visamp-io
R2_MASTERS_BUCKET=visamp-masters
AUDIO_LISTENER_HMAC_KEY=
VIEW_LISTENER_HMAC_KEY=
CRON_SECRET=

# SoundCloud — server-only, no NEXT_PUBLIC_ prefix. Client credentials are used
# to read public playlists; no SoundCloud user login is involved.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# AI code generation — server-only. Configure any provider you want to expose
# in the editor model selector, plus the validator service.
AI_GENERATION_ENABLED=false
AI_ABUSE_HMAC_KEY=
AI_RATE_WINDOW_SECONDS=3600
AI_RATE_LIMIT_PER_USER=10
AI_RATE_LIMIT_PER_IP=30
AI_CONCURRENT_LIMIT_PER_USER=2
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
AI_ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
AI_OPENAI_MODEL=

DASHSCOPE_API_KEY=
AI_QWEN_MODEL=qwen3.8-max
# Alibaba Model Studio URLs are specific to the account's region/workspace.
ALIBABA_BASE_URL=https://<workspace-id>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

AI_VALIDATOR_URL=http://visamp-2-production.up.railway.app

# Optional live integration test target. Leave unset to skip the R2 playback
# test in the validator suite.
HOSTED_AUDIO_TEST_TRACK_ID=
HOSTED_AUDIO_TEST_BASE_URL=http://localhost:3000
