WHITESPACE  = _{ " " | "\t" | "\r" | "\n" }

// `COMMENT` is a pest built-in name: like WHITESPACE it is skipped implicitly
// between tokens of every non-atomic rule, so comments are legal anywhere they
// would be in a normal language. Atomic rules are unaffected, which is why a
// `//` inside a string literal stays part of the string.
//
// This also means `a // b` reads as `a` followed by a comment, not as two
// divisions — the same as every other language using this syntax.
COMMENT     = _{ "//" ~ (!NEWLINE ~ ANY)* }

identifier  = @{ (ASCII_ALPHANUMERIC | "_")+ }
float       = @{ ("-"? ~ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+) }
boolean     = @{ ("true" | "false") }
integer     = @{ ("-"? ~ ASCII_DIGIT+) }
string      = @{ "\"" ~ ( "\\\"" | !"\"" ~ ANY )* ~ "\"" }

script = { SOI ~ (context_decl | prop_def | function_def | block)* ~ EOI }

// Selects the coordinate model. Legal anywhere at the top level; omitting it
// means 2d. Declaring it twice is rejected by the AST builder.
//
// Which backend 3d runs on — WebGL2 today — is the engine's business, not the
// author's, so there is nothing else to name here.
context_decl = { "context" ~ context_kind }
// Atomic with a trailing guard so `3dxyz` cannot match as `3d`.
context_kind = @{ ("3d" | "2d") ~ !(ASCII_ALPHANUMERIC | "_" | "-") }

// Atomic on purpose. In a normal rule pest inserts implicit WHITESPACE between
// sequence elements, so `on_` followed by a newline and the next block would
// match as a single name — half-typed `on_` in the editor swallowed the whole
// `render` block that followed it.
event_block_name  = @{ "on_" ~ ASCII_ALPHANUMERIC+ }
render_block_name = @{ "render" }

block = { (event_block_name|render_block_name) ~ "{" ~ statement* ~ "}" }

function_def = { "fn" ~ identifier ~ "(" ~ param_list? ~ ")" ~ "{" ~ statement* ~ "}" }
param_list = { param ~ ("," ~ param)* ~ ","? }
param = { identifier ~ ":" ~ expression }

// `call_expr` is a user-defined function called for its effect rather than its
// value. Without it here, `fn` was only reachable through `let x = f(...)` —
// a drawing helper, which is what `fn` is mostly for, could not be called at
// all. It sits after `function_call` so `draw::circle(...)` is still matched as
// a builtin.
statement = { function_call | call_expr | incr_decr | assignment | let_decl | if_statement | for_loop | while_loop | return_statement }

// `x++` / `++x`. Both spellings are accepted and mean the same thing: as a
// statement there is no surrounding expression for the pre/post distinction to
// matter to, and rejecting one spelling would only be a papercut.
incr_decr = { (identifier ~ incr_decr_operator) | (incr_decr_operator ~ identifier) }
incr_decr_operator = @{ "++" | "--" }

return_statement = { "return" ~ expression }

if_statement = { "if" ~ expression ~ then_block ~ else_block? }
then_block = { "{" ~ statement* ~ "}" }
else_block = { "else" ~ "{" ~ statement* ~ "}" }
for_loop = { "for" ~ identifier ~ "in" ~ for_iterable ~ "{" ~ statement* ~ "}" }

// A range must be tried before a bare expression, or the start value would
// match on its own and the `..` would be left dangling.
for_iterable = _{ range_expr | expression }
range_expr = { expression ~ range_op ~ expression ~ (step_kw ~ expression)? }
// Longest first: ".." would otherwise shadow "..=".
range_op = @{ "..=" | ".." }
// Guarded so an identifier like `stepper` is not read as `step` + `per`.
// Atomic: in a normal rule pest would skip whitespace before the lookahead,
// which would then test the character after the space and reject `step 2`.
step_kw = @{ "step" ~ !(ASCII_ALPHANUMERIC | "_") }
while_loop = { "while" ~ expression ~ "{" ~ statement* ~ "}" }

argument = { identifier ~ ":" ~ expression }
assignment = { identifier ~ assign_operator ~ expression }
// Compound forms first so `+=` is not read as a bare `=` would-be failure, and
// plain `=` guarded against `==` so a stray equality test is reported as such
// rather than as a half-parsed assignment.
assign_operator = @{ "+=" | "-=" | "*=" | "/=" | "%=" | ("=" ~ !"=") }

value = _{ boolean | float | integer | array | string | system_value | identifier }

system_value = @{ "$" ~ identifier }

array = { "[" ~ array_elements ~ "]" }

array_elements = _{ array_element ~ ("," ~ array_element)* ~ ","? }

array_element = _{ expression | array }

let_decl = { "let" ~ identifier ~ "=" ~ expression }
prop_def = { "prop" ~ identifier ~ "=" ~ value }

function_params = { "(" ~ (argument ~ ("," ~ argument)* ~ ","?)? ~ ")" }

// One or more namespace segments followed by the function name. Existing
// `draw::circle` calls have one namespace segment; libraries can nest, as in
// `effect::filter::blur`.
function_call = { function_path ~ function_params }
function_path = { identifier ~ ("::" ~ identifier)+ }

////////////////////////////////////
// Expression grammar starts here //
////////////////////////////////////

expression    = _{ logical_or_expr }  // Top level

// Precedence runs lowest to highest down this chain, following C: logical or,
// logical and, bitwise or, xor, and, then equality and the arithmetic below.
// That puts the bitwise operators *tighter* than `&&` but *looser* than `==`,
// which is the long-standing C ordering — `a & b == c` groups as `a & (b == c)`.
logical_or_expr = { logical_and_expr ~ (logical_or_operator ~ logical_and_expr)* }
logical_or_operator = @{ "||" }

logical_and_expr = { bit_or_expr ~ (logical_and_operator ~ bit_or_expr)* }
logical_and_operator = @{ "&&" }

// The single-character bitwise forms are guarded against their doubled
// counterparts, so `a || b` cannot be read as `a | (| b)` and left to
// backtracking to sort out.
bit_or_expr = { bit_xor_expr ~ (bit_or_operator ~ bit_xor_expr)* }
bit_or_operator = @{ "|" ~ !"|" }

bit_xor_expr = { bit_and_expr ~ (bit_xor_operator ~ bit_and_expr)* }
bit_xor_operator = @{ "^" }

bit_and_expr = { equality_expr ~ (bit_and_operator ~ equality_expr)* }
bit_and_operator = @{ "&" ~ !"&" }

equality_expr = { relational_expr ~ (equality_operator ~ relational_expr)* }
equality_operator = { "==" | "!=" }

relational_expr = { add_expr ~ (relational_operator ~ add_expr)* }
relational_operator = { "<=" | ">=" | "<" | ">" }

add_expr    = { mul_expr ~ (add_operator ~ mul_expr)* }
add_operator = { "+" | "-" }

mul_expr    = { unary_expr ~ (mul_operator ~ unary_expr)* }
// `\\` is integer division. It is a distinct operator rather than a spelling
// of `/` because `/` always yields a float.
mul_operator = { "*" | "/" | "%" | "\\" }

unary_expr  = { (unary_operator)* ~ postfix_expr }
unary_operator = { "!" | "-" | "+" }

// Indexing binds tighter than any operator, and chains: a[0][1].
postfix_expr = { primary_expr ~ index* }
index = { "[" ~ expression ~ "]" }

primary_expr = _{ math_expr | color_expr | asset_expr | call_expr | value | "(" ~ expression ~ ")" }

math_expr = { "math::" ~ math_func ~ "(" ~ math_args? ~ ")" }
// Longest-first, and atomic with a trailing guard. Ordered alternation means a
// shorter name listed earlier wins outright: `atan` used to match the start of
// `atan2` and leave the `2` dangling, so `math::atan2` never parsed at all.
math_func = @{
    (
        "atan2" | "asin" | "acos" | "atan" |
        "sin" | "cos" | "tan" |
        "sqrt" | "cbrt" | "abs" |
        "floor" | "ceil" | "round" | "trunc" |
        "pow" | "exp" | "log10" | "log2" | "ln" |
        "min" | "max" | "clamp"
    ) ~ !(ASCII_ALPHANUMERIC | "_")
}
math_args = { math_arg ~ ("," ~ math_arg)* ~ ","? }
math_arg = { identifier ~ ":" ~ expression }

// `asset::bitmap("<uuid>")`, with `id:` optional so both spellings the
// reference index recognises also parse. The id is a literal string rather than
// an expression: the index that answers "which visuals use this asset" is built
// by reading the source, and it cannot read a computed value.
asset_expr = { "asset::" ~ asset_kind ~ "(" ~ ("id" ~ ":")? ~ string ~ ")" }
asset_kind = { "bitmap" | "vector" | "model" }

color_expr = { "color::" ~ color_kind ~ "(" ~ color_args? ~ ")" }
color_kind = { "rgb" | "hsl" | "linear_gradient" }
color_args = { color_arg ~ ("," ~ color_arg)* }
color_arg = { identifier ~ ":" ~ expression }

call_expr = { identifier ~ "(" ~ call_args? ~ ")" }
call_args = { call_arg ~ ("," ~ call_arg)* ~ ","? }
call_arg = { identifier ~ ":" ~ expression }
