{
  "name": "@visamp/engine",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "description": "Visamp DSL interpreter and renderer, compiled to WebAssembly",
  "main": "./pkg/visamp_2.js",
  "types": "./pkg/visamp_2.d.ts",
  "exports": {
    ".": {
      "types": "./pkg/visamp_2.d.ts",
      "default": "./pkg/visamp_2.js"
    }
  },
  "sideEffects": [
    "./pkg/visamp_2.js",
    "./pkg/snippets/*"
  ],
  "files": [
    "pkg"
  ],
  "scripts": {
    "build": "./build-wasm.sh",
    "build:validator": "./with-toolchain.sh wasm-pack build --release --target web --out-dir pkg-validator",
    "build:native": "./with-toolchain.sh cargo build --release --bin visamp-validate",
    "check:parity": "./check-compiler-parity.sh",
    "dev": "./build-wasm.sh --dev",
    "test": "./with-toolchain.sh cargo test",
    "clean": "rm -rf pkg"
  }
}
