// Move over the canvas. Hold primary or secondary; Shift changes the orbit.
prop x = 0.0
prop y = 0.0
on_init { x = $WIDTH / 2 y = $HEIGHT / 2 }
on_frame {
  if input::pointer::state::is_inside() {
    x += (input::pointer::state::get_x() - x) * 0.12
    y += (input::pointer::state::get_y() - y) * 0.12
  }
}
render {
  draw::background(color: color::rgb(r: 0.015, g: 0.02, b: 0.06))
  let spread = 60.0
  if input::pointer::state::is_button_down(button: "primary") { spread = 130.0 }
  if input::pointer::state::is_button_down(button: "secondary") { spread = 25.0 }
  let speed = 0.8
  if input::keyboard::state::is_key_down(key: "Shift") { speed = -2.0 }
  for i in 0..40 {
    let angle = i * $TAU / 40 + $TIME_SEC * speed
    let radius = spread + math::sin(rad: $TIME_SEC * 2 + i * 0.3) * 20
    draw::circle(x: x + math::cos(rad: angle) * radius, y: y + math::sin(rad: angle) * radius, radius: 3 + i * 0.15, color: color::hsl(h: i / 40, s: 0.85, l: 0.65))
  }
  draw::text(content: "MOVE / HOLD PRIMARY OR SECONDARY / SHIFT", x: 20, y: 32, size: 15, color: $COLOR_WHITE)
}
