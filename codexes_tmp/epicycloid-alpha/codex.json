{
    "properties": [
        {
        "name": "custom_prop_points",
        "dataType": "i32",
        "description": "The base number of points for the epicycloid lines to be drawn between",
        "defaultValue": 32,
        "channel": "update",
        "inputControls": [{
          "type": "mouse",
          "action": "scrolly",
          "activationKey": {
            "key": "p"
          },
          "function": "log-asc",
          "cycle": false,
          "min": 1,
          "max": 512,
          "step": 1
        }]
      },
      {
        "name": "custom_prop_outer_line_thickness",
        "dataType": "i32",
        "description": "The thickness ",
        "defaultValue": 1,
        "channel": "update",
        "inputControls": [{
          "type": "mouse",
          "action": "scrolly",
          "activationKey": {
            "key": "l",
            "inputModifier": {
                "shiftKey": true
            }
          },
          "function": "log-asc",
          "cycle": false,
          "min": 1,
          "max": 512,
          "step": 1
        }]
      },
      {
        "name": "custom_prop_clear_opacity",
        "dataType": "f64",
        "description": "The thickness ",
        "defaultValue": 0.003,
        "channel": "update",
        "inputControls": [{
          "type": "mouse",
          "action": "scrolly",
          "activationKey": {
            "key": "c"
          },
          "function": "log-asc",
          "cycle": false,
          "min": 0,
          "max": 0.01,
          "step": 0.0001
        }]
      }
    ],
    "initProperties": {
      "context_2d_zoom": 0.6,
      "css_filters_hue_rotate": 260,
      "css_filters_saturate": 1.5,
      "css_filters_contrast": 2.0,
      "css_filters_sepia": 0.839
    },
    "context": "2d",
    "lib": [],
    "macros": [{
      "type": "loop-updated",
      "property": "context_2d_zoom",
      "exec": "return 0.6 + Math.sin(t / 5000) / 3"
    }],
    "assets": []
}
