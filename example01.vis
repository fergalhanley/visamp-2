prop angle = 2.0
prop x = 0.0
prop y = 0.0
prop isBlue = false

on_frame {
  angle = $TIME_SEC
}

layer_2d {
  draw::background(
    color: $BLACK
  )
  let points = [
    [0.0, 100.0],
    [-100.0, -100.0],
    [100.0, -100.0],
  ]
  draw::polygon (
    points: [
      [0.0, 100.0],
      [-100.0, -100.0],
      [100.0, -100.0],
    ],
    color: $RED,
    rotate: angle
  )
}
